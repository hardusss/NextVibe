# NextVibe nft-service (Bun). Copy to nft-service/.env; it is loaded from the working directory.

# Base58 secret key of the backend wallet: fee payer for every mint, tree creator and collection authority
SOLANA_PRIVATE_KEY=
# Solana RPC URL with API key (Helius), used for sending transactions and Token-2022 scans
HELIUS_RPC_URL=
# Bubblegum Merkle tree that stores every compressed NFT leaf (create it with `bun run src/create-tree.ts`)
MERKLE_TREE_ADDRESS=
# Collection for /mint and /collect/* (posts and event POAPs)
COLLECTION_ADDRESS=
# Collection for /mint/og (the OG badge)
OG_COLLECTION_ADDRESS=
# Proof of Meet collection (create once with `bun run src/create-meet-collection.ts`); empty makes /mint/meet answer 503
MEET_COLLECTION_ADDRESS=
# URL prefix of Proof of Meet metadata JSON (default https://api.nextvibe.io/meta/meet/)
MEET_METADATA_PREFIX=
