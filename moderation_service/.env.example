# NextVibe moderation_service (Go). Copy to moderation_service/.env; godotenv loads it from the working directory.

# HTTP port (default 8080; the API calls http://127.0.0.1:8080/moderation)
PORT=
# API endpoint that receives moderation results (the API's /api/v1/posts/moderation-callback/)
CALLBACK_URL=
# OpenAI API key for text and image moderation
OPENAI_API_KEY=
# Sightengine API user; at least one user/secret pair is needed
SIGHTENGINE_USER=
# Sightengine API secret for SIGHTENGINE_USER
SIGHTENGINE_SECRET=
# Optional extra Sightengine pairs SIGHTENGINE_USER2/SIGHTENGINE_SECRET2 … SIGHTENGINE_USER10/SIGHTENGINE_SECRET10; one pair is picked at random per request
SIGHTENGINE_USER2=
# Secret for SIGHTENGINE_USER2 (and so on up to 10)
SIGHTENGINE_SECRET2=
