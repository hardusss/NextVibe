# NextVibe moderation_service (Go). Copy to moderation_service/.env; godotenv loads it from the working directory.

# Address to listen on (default 127.0.0.1: only the API on this host calls the service)
HOST=
# HTTP port (default 8080; the API calls http://127.0.0.1:8080/moderation)
PORT=
# API endpoint that receives moderation results (default http://127.0.0.1:8000/api/v1/posts/moderation-callback/)
CALLBACK_URL=
# Sent as X-Moderation-Secret on the callback; must equal the API's MODERATION_CALLBACK_SECRET
MODERATION_CALLBACK_SECRET=
# Required. OpenAI API key; /moderation checks text and images with omni-moderation-latest
OPENAI_API_KEY=
# Not used by the running handler: read only by the Sightengine code (image_moderation.go, text_moderation.go,
# video_moderation.go), which main.go doesn't call. Pairs SIGHTENGINE_USER/SIGHTENGINE_SECRET, then …2 to …10.
SIGHTENGINE_USER=
# Sightengine secret for SIGHTENGINE_USER (unused, see above)
SIGHTENGINE_SECRET=
