# NextVibe tx-indexer (Bun). Copy to tx-indexer/.env; Bun loads it from the working directory.
# Keys marked "required" stop the service at startup when empty (src/config/env.ts).

# HTTP port (default 3000; nft-service also uses 3000, so pick another one on a shared host)
PORT=
# development | production (default development)
NODE_ENV=
# Required. Shared secret checked on x-internal-secret and sent to Django; must equal the API's INDEXER_INTERNAL_SECRET
INTERNAL_SECRET=

# MySQL connection URL (the same database as Django); when empty, the MYSQL_* keys below are required
MYSQL_URL=
# MySQL host, used when MYSQL_URL is empty
MYSQL_HOST=
# MySQL port (default 3306)
MYSQL_PORT=
# MySQL user, used when MYSQL_URL is empty
MYSQL_USER=
# MySQL password, used when MYSQL_URL is empty
MYSQL_PASSWORD=
# MySQL database, used when MYSQL_URL is empty
MYSQL_DATABASE=
# "true" turns on TLS to MySQL (default off)
MYSQL_SSL=
# Django's users table (default user_user)
USERS_TABLE=

# Redis URL for the job queue and cache; when empty, built from REDIS_HOST and REDIS_PORT
REDIS_URL=
# Redis host (default localhost)
REDIS_HOST=
# Redis port (default 6379)
REDIS_PORT=

# Required. Helius API key for fetching transactions and managing the webhook
HELIUS_API_KEY=
# Required. Id of the Helius webhook this service keeps in sync with user wallets
HELIUS_WEBHOOK_ID=
# Required. Set on the Helius webhook as its auth header; incoming webhook calls must carry it
HELIUS_WEBHOOK_SECRET=
# Required. Public URL of this service's webhook endpoint, registered with Helius
HELIUS_WEBHOOK_URL=

# Transactions fetched when a wallet is first indexed (default 10)
INITIAL_FETCH_LIMIT=
# Page size for "load more" (default 50)
LOAD_MORE_DEFAULT_LIMIT=
# Max addresses kept on the Helius webhook (default 100 in src/services/webhook-manager.ts)
HELIUS_WEBHOOK_ADDRESS_LIMIT=
# Django API base URL; the worker posts wallet notifications to /api/v1/wallets/webhook-notify/ (default http://127.0.0.1:8000)
DJANGO_API_URL=
