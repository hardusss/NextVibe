# NextVibe socket_service (FastAPI, realtime). Copy to socket_service/.env; it is loaded from the working directory.

# "production" turns on real R2 object checks (default development)
ENVIRONMENT=
# Log level (default INFO)
LOG_LEVEL=
# Redis host for connections, pub/sub and rate limits (default 127.0.0.1)
REDIS_HOST=
# Redis port (default 6379)
REDIS_PORT=
# Redis database number (default 0)
REDIS_DB=
# Largest chat media upload in MB (default 100)
MAX_MEDIA_SIZE_MB=
# Open sockets allowed per user (default 5)
MAX_CONNECTIONS_PER_USER=
# Longest message text in characters (default 10000)
MAX_TEXT_LENGTH=
# Events one user may send per second (default 10)
MAX_EVENTS_PER_SECOND=
# Comma-separated CORS origins (default none)
CORS_ORIGINS=
# Name of this instance for cross-pod routing (default pod-<random>)
POD_ID=

# Required. Verifies the API's JWTs; must equal the API's SECRET_KEY
JWT_SECRET_KEY=
# JWT algorithm (default HS256)
JWT_ALGORITHM=

# SQLAlchemy URL of the API's MySQL database; when empty it is built from the DB_* keys
DATABASE_URL=
# MySQL host (default localhost)
DB_HOST=
# MySQL port (default 3306)
DB_PORT=
# MySQL user (default root)
DB_USER=
# MySQL password (default empty)
DB_PASSWORD=
# MySQL database (default nextvibe)
DB_NAME=

# Cloudflare R2 endpoint host, without https://
ENDPOINT_URL=
# Cloudflare R2 access key id
R2_ACCESS_KEY_ID=
# Cloudflare R2 secret access key
R2_SECRET_ACCESS_KEY=
# Media bucket for chat uploads
BUCKET_NAME=
# Public domain of the media bucket (default media.nextvibe.io)
CUSTOM_DOMAIN=
