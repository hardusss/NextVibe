# NextVibe app (Expo). Copy to frontend/NextVibe/.env. EXPO_PUBLIC_* values are bundled into the app.
# The API base URL is not an env var: src/utils/url_api.ts points at https://api.nextvibe.io/api/v1.

# Mapbox secret download token (scope DOWNLOADS:READ); needed at prebuild/build time for @rnmapbox/maps
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
# Mapbox public token for the maps and place names; without it maps don't load
EXPO_PUBLIC_MAPBOX_TOKEN=
# Jupiter API key for token swaps
EXPO_PUBLIC_JUPITER_API_KEY=
# LazorKit paymaster URL, sponsors passkey wallet transactions (default https://paymaster.lazor.sh)
EXPO_PUBLIC_PAYMASTER_URL=
# LazorKit paymaster API key
EXPO_PUBLIC_PAYMASTER_API_KEY=
# Vexo analytics key; empty (or a dev build) skips analytics
EXPO_PUBLIC_VEXO_API_KEY=
