# NextVibe API (Django). Copy to backend/NextVibeAPI/.env and fill in.
# python-dotenv looks in backend/NextVibeAPI/NextVibeAPI/ first, then walks up.
# Every key the code reads is listed; unset keys fall back to the default noted.

# "prod" loads NextVibeAPI/setting/prod.py (DEBUG off, hosts and CORS from env); anything else loads setting/dev.py
DJANGO_ENV=
# Django secret key; also signs JWTs and meet slugs. socket_service's JWT_SECRET_KEY must hold the same value
SECRET_KEY=
# prod only: comma-separated host names the API answers on
ALLOWED_HOSTS=
# prod only: comma-separated origins allowed by CORS
CORS_ALLOWED_ORIGINS=
# Absolute base for image URLs in share cards (default https://api.nextvibe.io)
PUBLIC_API_URL=
# Public base URL of stored media; empty means https://<CUSTOM_DOMAIN>
PUBLIC_MEDIA_URL=

# MySQL database name (dev and prod settings both use MySQL)
DB_NAME=
# MySQL user
DB_USER=
# MySQL password
DB_PASSWORD=
# MySQL host
DB_HOST=
# MySQL port
DB_PORT=

# Cloudflare R2 access key id (S3 API), used for all media
R2_ACCESS_KEY_ID=
# Cloudflare R2 secret access key
R2_SECRET_ACCESS_KEY=
# Public media bucket name
BUCKET_NAME=
# R2 S3 endpoint host, without https:// (the settings add it)
ENDPOINT_URL=
# Public domain that serves the media bucket
CUSTOM_DOMAIN=
# Private bucket for Proof of Meet selfies; empty turns selfies off (uploads answer 503)
R2_PRIVATE_BUCKET_NAME=
# Local runs only: keep selfies in this directory instead of the private bucket
MEET_PHOTO_LOCAL_DIR=

# Cloudinary cloud name (legacy: only old posts still point at res.cloudinary.com)
CLOUD_NAME=
# Cloudinary API key (legacy)
API_KEY=
# Cloudinary API secret (legacy)
API_SECRET=

# socket_service's Redis; Django publishes in-app events on its pub/sub channel (default redis://127.0.0.1:6379/0)
REALTIME_REDIS_URL=

# Shared with moderation_service, which sends it as X-Moderation-Secret on its result callback; empty refuses every callback
MODERATION_CALLBACK_SECRET=

# Helius API key: DAS lookups for minted collectibles, the /api/v1/wallets/rpc/ proxy, check_balances
HELIUS_API_KEY=
# nft-service base URL (default http://localhost:3000)
NFT_SERVICE_URL=
# Shared secret sent as x-internal-secret on every call to nft-service; must equal its NFT_SERVICE_SECRET
NFT_SERVICE_SECRET=
# tx-indexer base URL (default http://localhost:3000; give the two services different ports)
INDEXER_URL=
# Shared secret sent as x-internal-secret to tx-indexer; must equal its INTERNAL_SECRET
INDEXER_INTERNAL_SECRET=
# Global cap on queued collectible mints per UTC day, in-flight ones included (default 5000)
COLLECTIBLES_DAILY_MINT_CAP=
# Max collectibles one person's queue run puts on-chain (default 200)
COLLECTIBLES_USER_BATCH_CAP=
# Seconds between two queued mints (default 0.2)
COLLECTIBLES_MINT_PAUSE=

# Django email backend (default nvcli.email_backend.ResendBackend; the server can't use SMTP)
EMAIL_BACKEND=
# Resend API key for all email
RESEND_API_KEY=
# Signing secret of the Resend webhook behind /api/v1/nv/resend-webhook/; empty rejects every call
RESEND_WEBHOOK_SECRET=
# From address for email
DEFAULT_FROM_EMAIL=
# From address for sign-in and password reset codes (default: DEFAULT_FROM_EMAIL)
EMAIL_CODE_FROM=
# true: email + password accounts confirm their email with a 6-digit code before login and
# registration return tokens (Google, Apple and wallet sign-in don't). Turn on after the app update ships.
EMAIL_VERIFICATION_REQUIRED=

# Optional Expo access token for push sends from the nv console (nvcli/send_push.py)
EXPO_ACCESS_TOKEN=

# Mapbox token for reverse geocoding (meet city); without it the API uses OpenStreetMap Nominatim
MAPBOX_ACCESS_TOKEN=
# Older name for the same Mapbox token, read when MAPBOX_ACCESS_TOKEN is empty
MAPBOX_TOKEN=
# Replicate API token for AI image generation in posts
REPLICATE_API_TOKEN=
# Cherry group chat app id (chat/views_cherry.py)
CHERRY_APP_ID=
# Cherry app secret; signs the chat embed tokens (HS256)
CHERRY_APP_SECRET=
# Cherry project key, Bearer for Cherry's group API (member list)
CHERRY_PROJECT_KEY=
# Ethereum RPC URL for the legacy fee estimate endpoint (/api/v1/wallets/fee/)
ETH_RPC_LINK=
# Fallback Helius key for the check_balances command when HELIUS_API_KEY is empty
RPC_KEY=
